{
  "name": "@dribgib/clawguard",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Revolutionary security scanner for AI agent skills - LLM-powered semantic analysis, multi-skill attack chains, prompt injection detection",
  "keywords": [
    "security",
    "ai",
    "agent",
    "scanner",
    "llm",
    "prompt-injection",
    "skills"
  ],
  "author": "Mike Cavallo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikecavallo/clawguard"
  },
  "homepage": "https://github.com/mikecavallo/clawguard#readme",
  "bugs": {
    "url": "https://github.com/mikecavallo/clawguard/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clawguard": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-patterns",
    "copy-patterns": "cp -r src/patterns dist/",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "scan": "node dist/cli.js",
    "postinstall": "node -e \"if(process.stdout.isTTY && !process.env.CI) console.log('\\n🛡️  ClawGuard installed! Run: clawguard init\\n')\""
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.52.0"
  },
  "dependencies": {
    "acorn": "^8.11.0",
    "acorn-walk": "^8.3.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "glob": "^10.3.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
